    {"align": "left", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "Registration notice", "start": [72.00, 717.56], "end": [164.97, 717.56], "size": 11.00, "vertical": false}
    ]},
    {"align": "left", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "The Annual Members’ Meeting of the Harbour Housing Cooperative takes place on Friday,", "start": [72.00, 683.33], "end": [511.56, 683.33], "size": 11.00, "vertical": false},
      {"text": "20 November 2026, at 18:30 in the community hall, 3 Quay Street.", "start": [72.00, 667.38], "end": [400.90, 667.38], "size": 11.00, "vertical": false}
    ]},
    {"align": "left", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "Members who wish to attend are asked to register by 13 November 2026. Each member", "start": [72.00, 641.43], "end": [505.70, 641.43], "size": 11.00, "vertical": false},
      {"text": "may bring one guest. Please tell us in advance if you need step-free access or a sign", "start": [72.00, 625.48], "end": [483.84, 625.48], "size": 11.00, "vertical": false},
      {"text": "language interpreter.", "start": [72.00, 609.53], "end": [175.81, 609.53], "size": 11.00, "vertical": false}
    ]},
    {"align": "left", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "The agenda covers the annual report, the accounts for 2025, the election of two board", "start": [72.00, 583.58], "end": [495.73, 583.58], "size": 11.00, "vertical": false},
      {"text": "members and the proposal to renovate the shared laundry.", "start": [72.00, 567.63], "end": [361.85, 567.63], "size": 11.00, "vertical": false}
    ]},
    {"align": "left", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "This document contains scripts that check the registration details when it is opened in a", "start": [72.00, 541.68], "end": [503.37, 541.68], "size": 11.00, "vertical": false},
      {"text": "viewer that runs them.", "start": [72.00, 525.73], "end": [182.99, 525.73], "size": 11.00, "vertical": false}
    ]}
  ]}
