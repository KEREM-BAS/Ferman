    {"align": "left", "justify": null, "column": 2, "cell": null, "lines": [
      {"text": "アイシェ・ユルマズ様", "start": [439.35, 769.89], "end": [439.35, 659.22], "size": 10.50, "vertical": true}
    ]},
    {"align": "left", "justify": null, "column": 5, "cell": null, "lines": [
      {"text": "拝啓　秋冷の候、ますますご清祥のこととお喜び申し上げます。さて、現在ご契約いただいて", "start": [401.14, 769.89], "end": [401.14, 303.06], "size": 10.50, "vertical": true},
      {"text": "おります賃貸借契約は、二〇二六年十一月三十日をもって期間満了となります。つきましては、", "start": [380.66, 769.89], "end": [380.66, 291.93], "size": 10.50, "vertical": true},
      {"text": "契約更新の手続きについて下記のとおりご案内申し上げます。更新後の月額賃料は19万五千円", "start": [360.19, 769.89], "end": [360.19, 303.06], "size": 10.50, "vertical": true},
      {"text": "です。", "start": [339.71, 769.89], "end": [339.71, 737.13], "size": 10.50, "vertical": true}
    ]},
    {"align": "right", "justify": null, "column": 2, "cell": null, "lines": [
