    ]},
    {"align": "justified", "justify": "tj", "column": 0, "cell": null, "lines": [
      {"text": "بلغ عدد أعضاء الجمعية في 31 كانون الأول 2025 ما مجموعه 3,480 عضوًا، منهم 1,162 عضوًا", "start": [72.00, 686.73], "end": [523.28, 686.73], "size": 12.00, "vertical": false},
      {"text": "تسلموا وحداتهم، و2,318 عضوًا على قائمة الانتظار.", "start": [296.66, 663.93], "end": [523.28, 663.93], "size": 12.00, "vertical": false}
    ]},
    {"align": "right", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "ويبين الجدول التالي تطور عدد الأعضاء خلال السنوات الخمس الأخيرة.", "start": [221.45, 633.13], "end": [523.28, 633.13], "size": 12.00, "vertical": false}
    ]},
