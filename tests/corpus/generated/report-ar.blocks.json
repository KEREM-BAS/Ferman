    {"align": "justified", "justify": "tj", "column": 0, "cell": null, "lines": [
      {"text": "بلغ مجموع الوحدات المسلمة 214 وحدة، تتراوح مساحاتها بين 110 و165 مترًا مربعًا، وبلغ متوسط", "start": [72.00, 481.13], "end": [523.28, 481.13], "size": 12.00, "vertical": false},
      {"text": "كلفة المتر المربع 285 دينارًا.", "start": [401.32, 458.33], "end": [523.28, 458.33], "size": 12.00, "vertical": false}
    ]},
    {"align": "center", "justify": null, "column": 0, "cell": null, "lines": [
