    {"align": "justified", "justify": "tj", "column": 0, "cell": null, "lines": [
      {"text": "وارتفع متوسط مدة الانتظار من 50 شهرًا إلى 55 شهرًا بسبب زيادة الطلب، ونعمل على خفضها بطرح", "start": [72.00, 450.33], "end": [523.28, 450.33], "size": 12.00, "vertical": false},
      {"text": "مشاريع جديدة.", "start": [455.30, 427.53], "end": [523.28, 427.53], "size": 12.00, "vertical": false}
