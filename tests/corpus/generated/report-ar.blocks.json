    ]},
    {"align": "left", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "التقرير السنوي 2025", "start": [72.00, 785.89], "end": [143.14, 785.89], "size": 9.00, "vertical": false}
    ]},
    {"align": "right", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "التمويل والتسجيل", "start": [396.50, 724.65], "end": [523.28, 724.65], "size": 18.00, "vertical": false}
    ]},
    {"align": "justified", "justify": "tj", "column": 0, "cell": null, "lines": [
      {"text": "موّلت الجمعية مشاريعها من مساهمات الأعضاء ومن قروض ميسرة من ثلاثة بنوك محلية بلغ مجموعها", "start": [72.00, 686.73], "end": [523.28, 686.73], "size": 12.00, "vertical": false},
      {"text": "4,750,000 دينار. وانخفض متوسط سعر الفائدة على قروض الأعضاء من 7.25% إلى 6.4%.", "start": [115.56, 663.93], "end": [523.28, 663.93], "size": 12.00, "vertical": false}
    ]},
    {"align": "justified", "justify": "tj", "column": 0, "cell": null, "lines": [
      {"text": "يسدد العضو قرضه على أقساط شهرية لمدة تصل إلى 20 سنة، ولا يتجاوز القسط 35% من دخل", "start": [72.00, 633.13], "end": [523.28, 633.13], "size": 12.00, "vertical": false},
      {"text": "الأسرة.", "start": [494.34, 610.33], "end": [523.28, 610.33], "size": 12.00, "vertical": false}
    ]},
    {"align": "justified", "justify": "tj", "column": 0, "cell": null, "lines": [
      {"text": "وفي مجال التسجيل، تقلصت مدة نقل ملكية الوحدة إلى اسم العضو من 90 يومًا إلى 35 يومًا، بعد ربط", "start": [72.00, 579.53], "end": [523.28, 579.53], "size": 12.00, "vertical": false},
      {"text": "الجمعية بنظام التسجيل الإلكتروني لدى الجهات المختصة.", "start": [273.44, 556.73], "end": [523.28, 556.73], "size": 12.00, "vertical": false}
    ]},
    {"align": "right", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "ويمكن للأعضاء الآن متابعة طلباتهم ودفع أقساطهم عبر الموقع الإلكتروني للجمعية.", "start": [165.74, 525.93], "end": [523.28, 525.93], "size": 12.00, "vertical": false}
    ]},
    {"align": "center", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "٨", "start": [294.98, 48.00], "end": [300.29, 48.00], "size": 10.00, "vertical": false}
    ]}
  ]},
