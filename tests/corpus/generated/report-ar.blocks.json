    {"align": "center", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "يعرض هذا التقرير أعمال الجمعية خلال عام 2025، ومشاريع الإسكان التي أُنجزت، والوضع", "start": [86.23, 464.01], "end": [509.05, 464.01], "size": 13.00, "vertical": false},
