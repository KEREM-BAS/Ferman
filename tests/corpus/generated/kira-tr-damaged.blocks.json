    ]},
    {"align": "left", "justify": null, "column": 0, "cell": null, "lines": [
      {"text": "Taraflar, bu sözleşmenin tüm maddelerini okuduklarını ve kabul ettiklerini beyan eder.", "start": [72.00, 744.07], "end": [503.54, 744.07], "size": 10.50, "vertical": false}
    ]},
